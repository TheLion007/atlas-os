{
  "name": "atlas-os",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "TheLion007"
  },
  "description": "Atlas OS — a Personal Project Intelligence OS (desktop app)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:verify": "node scripts/local-db-verify.mjs",
    "build:server": "node scripts/build-server.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:icon": "electron scripts/make-icon.cjs",
    "dist:dir": "node scripts/build-server.mjs && node scripts/stage-updater.mjs && electron-builder --dir --win --x64 --publish never",
    "dist:win": "node scripts/build-server.mjs && node scripts/stage-updater.mjs && electron-builder --win --x64 --publish never",
    "dist:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.103.2",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "electron-updater": "^6.8.11",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "axe-core": "^4.13.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "main": "electron/main.cjs",
  "homepage": "https://github.com/TheLion007/atlas-os"
}
