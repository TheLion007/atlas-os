# @react-three/fiber@9.7.0 declares a peer range of react/react-dom ">=19 <19.3", which
# excludes the 19.3.0 already pinned across the app (no reconciler-breaking change between
# 19.0 and 19.3 affects it). Without this, npm install/ci refuses to resolve the tree.
# Revisit once @react-three/fiber publishes a release with a wider peer range.
legacy-peer-deps=true
