# Copy to .env.local if you need to change a default. NEVER commit real values.
# Only this file (.env.example) is tracked by git. Every variable here is optional.

# Where the local database folder lives (default: data/atlas-pgdata, relative to the project).
ATLAS_DB_DIR=

# Where `npm run db:backup` writes dated copies (default: D:/backups/atlas).
ATLAS_BACKUP_DIR=

# Runs the whole app on illustrative fixtures with no database (demo mode). Set to 1 locally.
# Never active in production, whatever its value.
NEXT_PUBLIC_ATLAS_FIXTURES=

# --- Assistant (optional) ---
# Absent => the assistant answers deterministically from graph data only.
ANTHROPIC_API_KEY=
